{
  "name": "web",
  "packageManager": "pnpm@10.34.5",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "verify:loading": "node scripts/verify-loading-architecture.mjs",
    "verify:tailwind": "node scripts/verify-tailwind-architecture.mjs",
    "verify": "node scripts/verify-tailwind-architecture.mjs && node scripts/verify-loading-architecture.mjs && node scripts/verify-component-reuse.mjs && node scripts/verify-workflow-contracts.mjs && node scripts/verify-semantic-ui.mjs && node scripts/verify-brand-and-review-layout.mjs",
    "verify:reuse": "node scripts/verify-component-reuse.mjs",
    "verify:workflow": "node scripts/verify-workflow-contracts.mjs",
    "verify:e2e": "playwright test",
    "verify:visual": "playwright test e2e/visual-review.spec.ts",
    "verify:semantic": "node scripts/verify-semantic-ui.mjs",
    "verify:brand-review": "node scripts/verify-brand-and-review-layout.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "verify:production": "pnpm run verify && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run verify:safety && pnpm run build",
    "verify:safety": "node scripts/verify-production-safety.mjs"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "nextjs-toploader": "3.9.17",
    "openapi-fetch": "^0.17.0",
    "pdfjs-dist": "^6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
