[Unit]
Description=AMIR Lab web application
After=network-online.target amirl-api.service
Wants=network-online.target

[Service]
Type=simple
User=amirl
Group=amirl
WorkingDirectory=/opt/amirl/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/env pnpm start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/amirl/frontend/.next/cache

[Install]
WantedBy=multi-user.target
