[Unit]
Description=AMIR Lab API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=amirl
Group=amirl
WorkingDirectory=/opt/amirl/backend
EnvironmentFile=/etc/amirl/api.env
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/amirl/.local/bin
ExecStart=/usr/bin/env pnpm start:prod
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/amirl/uploads

[Install]
WantedBy=multi-user.target
