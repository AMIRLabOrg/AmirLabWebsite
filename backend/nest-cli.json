{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "applications/brand/amirlab-logo.png",
        "watchAssets": true
      },
      {
        "include": "applications/brand/amirlab-wordmark.png",
        "watchAssets": true
      },
      {
        "include": "applications/brand/*.ttf",
        "watchAssets": true
      }
    ]
  }
}
