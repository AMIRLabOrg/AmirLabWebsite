{
  "name": "amirlab",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web run dev",
    "dev:backend": "pnpm --filter api run dev",
    "dev:frontend": "pnpm --filter web run dev",
    "build": "pnpm --recursive run build",
    "format": "pnpm --recursive run format",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --filter api run test",
    "db:start": "pnpm --filter api run db:start",
    "db:stop": "pnpm --filter api run db:stop",
    "db:status": "pnpm --filter api run db:status",
    "db:cluster:reset": "pnpm --filter api run db:cluster:reset",
    "db:reset": "pnpm --filter api run db:rebuild",
    "db:start:docker": "docker compose up -d postgres",
    "db:stop:docker": "docker compose stop postgres",
    "db:logs:docker": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter api run db:generate",
    "db:push": "pnpm --filter api run db:push",
    "seed:validate": "pnpm --filter api run seed:validate",
    "db:seed": "pnpm --filter api run db:seed",
    "db:verify": "pnpm --filter api run db:verify",
    "db:rebuild": "pnpm --filter api run db:rebuild",
    "db:setup": "pnpm run db:rebuild",
    "verify": "pnpm run verify:architecture && pnpm --filter web run verify",
    "verify:architecture": "node verification/verify-bulk-reviews.mjs && node verification/verify-profile-entry-labels.mjs",
    "verify:loading": "pnpm --filter web run verify:loading",
    "verify:tailwind": "pnpm --filter web run verify:tailwind",
    "verify:reuse": "pnpm --filter web run verify:reuse",
    "verify:workflow": "pnpm --filter web run verify:workflow",
    "verify:e2e": "pnpm --filter web run verify:e2e",
    "verify:visual": "pnpm --filter web run verify:visual",
    "verify:production": "pnpm --filter api run verify:production && pnpm --filter web run verify:production"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0"
  }
}
